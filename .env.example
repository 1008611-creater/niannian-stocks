# Railway production variables. Do not put values in the frontend VITE_ namespace.
NODE_ENV=production
PORT=3000
FMP_API_KEY=
FINNHUB_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# QQ 邮箱登录与个人云数据。匿名公钥仅经 `/api/auth/config` 给网页使用；service role 只能留在 Railway。
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# TradingAgents service on Railway. Keep these server-only and do not use VITE_.
AGENT_SERVICE_URL=
NIANNIAN_AGENT_SERVICE_TOKEN=
