{
  "name": "niannian-stocks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node --env-file-if-exists=.env.local server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "check": "tsc -b && node --check server/index.mjs && node --check server/market.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "convex": "^1.43.0",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lightweight-charts": "^5.0.8",
    "preact": "^10.26.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@preact/preset-vite": "^2.10.1",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
